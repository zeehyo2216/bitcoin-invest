# Binance API Credentials
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Trading Configuration
SYMBOL=BTCUSDT
LEVERAGE=20
INITIAL_BALANCE=600
INTERVAL=5m
TESTNET=False

# Logging Configuration
# LOG_DIR=/var/log/trading_bot  # 리눅스 서버 환경 (root 권한 필요할 수 있음)
# LOG_DIR=./logs                # 프로젝트 디렉토리 내 logs 폴더 (기본값, 권장)
# LOG_TO_CONSOLE=true           # 콘솔에도 출력 (true/false)
