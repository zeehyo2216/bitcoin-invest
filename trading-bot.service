[Unit]
Description=Binance Futures Trading Bot
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/path/to/bitcoin-invest
Environment="PATH=/usr/bin:/usr/local/bin"
ExecStart=/usr/bin/python3 /path/to/bitcoin-invest/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# 리소스 제한 (선택사항)
MemoryLimit=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target

